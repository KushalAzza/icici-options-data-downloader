# Dhan API Credentials
# https://dhanhq.co/
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=

# Dhan instrument id: NIFTY=13, India VIX=21
USE_SECURITY_ID=13

# ICICI Direct / Breeze Connect
# https://www.icicidirect.com/
ICICI_API_KEY=
ICICI_SECRET_KEY=
ICICI_SESSION_TOKEN=

# Spot, monthly options, and Dhan intraday (YYYY-MM-DD)
START_DATE=2025-01-01
END_DATE=2025-12-31

# Monthly options expiry weekday: 0=Monday … 6=Sunday (NIFTY often Thursday = 3)
EXPIRY_DAY=3

# Manual options download (YYYY-MM-DD)
M_START_DATE=2025-01-01
M_END_DATE=2025-01-31
M_EXPIRY_DATE=2025-01-30


# Dhan Instrument Configuration
# USE_SECURITY_ID: Dhan securityId for the index you want to download
# Common values: NIFTY=13, India VIX=21
USE_SECURITY_ID=13

# ICICI Direct / Breeze Connect API Credentials
# Get your credentials from: https://www.icicidirect.com/
ICICI_API_KEY=your_icici_api_key_here
ICICI_SECRET_KEY=your_icici_secret_key_here
ICICI_SESSION_TOKEN=your_icici_session_token_here

# Monthly Options Download Configuration
# Date format: YYYY-MM-DD
START_DATE=2025-01-01
END_DATE=2025-12-31

# Expiry Day: 0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday, 5=Saturday, 6=Sunday
# For NIFTY, expiry is typically on Thursday (3)
EXPIRY_DAY=3

# Manual Options Download Configuration
# Use these if you want to specify a specific expiry date
# Date format: YYYY-MM-DD
M_START_DATE=2025-01-01
M_END_DATE=2025-01-31
M_EXPIRY_DATE=2025-01-30
